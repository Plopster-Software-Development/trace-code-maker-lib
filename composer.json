{
    "name": "plopster/trace-code-maker",
    "description": "A Laravel library designed to create and manage unique trace codes for monitoring, logging, and tracing errors or responses within services. Easy installation with automated setup commands.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "trace", "logging", "monitoring", "error-tracking"],
    "autoload": {
        "psr-4": {
            "Plopster\\TraceCodeMaker\\": "src/"
        }
    },
    "authors": [
        {
            "name": "nicodav28",
            "email": "nicolas.estevez@plopster.com.co"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/database": "^9.0|^10.0|^11.0",
        "illuminate/console": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plopster\\TraceCodeMaker\\TraceCodeMakerServiceProvider"
            ],
            "aliases": {
                "TraceCodeMaker": "Plopster\\TraceCodeMaker\\Facades\\TraceCodeMaker"
            }
        }
    }
}